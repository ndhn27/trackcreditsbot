# ── Required ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
DATABASE_URL=postgresql://user:password@localhost:5432/trackcredits

# ── Strongly recommended ──────────────────────────────────────────────────
GENIUS_TOKEN=your_genius_token_here   # get free at genius.com/api-clients
ADMIN_CHAT_ID=your_telegram_user_id  # get from @userinfobot
# ADMIN_CHAT_IDS=111111,222222        # multi-admin: comma-separated (overrides ADMIN_CHAT_ID)

# ── Webhook mode (leave unset for polling / local dev) ───────────────────
# WEBHOOK_URL=https://your-domain.com
# WEBHOOK_PORT=8443
# WEBHOOK_PATH=/webhook
# Required if WEBHOOK_URL is set — without it, /webhook is an unauthenticated
# public endpoint. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBHOOK_SECRET_TOKEN=

# ── Payment ───────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=manual   # momo | stripe | manual

# MoMo (Vietnam)
# MOMO_PARTNER_CODE=MOMOXXXXXXXX
# MOMO_ACCESS_KEY=your_access_key
# MOMO_SECRET_KEY=your_secret_key
# MOMO_IPN_URL=https://your-domain.com/payment/momo/ipn
# MOMO_REDIRECT_URL=https://t.me/YourBot

# Stripe (International)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BOT_BASE_URL=https://your-domain.com

# ── System ────────────────────────────────────────────────────────────────
HEALTH_PORT=8080          # health check + payment webhook port
# LOG_FILE=logs/bot.log   # optional: enable rotating file log

# ── Credits ───────────────────────────────────────────────────────────────
CREDITS_STARTING=20
CREDITS_SEARCH_COST=1
CREDITS_DAILY_BONUS=3

# ── Admin Dashboard ───────────────────────────────────────────────────────
# Protect the /admin/* web dashboard with a secret password.
# Visit http://your-host:8080/admin/ and enter this password.
DASHBOARD_SECRET=change_me_to_a_strong_random_string
# DASHBOARD_INSECURE_COOKIE=true   # Uncomment ONLY for local HTTP dev (disables Secure cookie flag)
